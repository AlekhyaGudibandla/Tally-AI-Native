# Environment variables for LedgerOS / Vahi
DATABASE_URL="file:./dev.db"
AUTH_SECRET="generate-a-new-secret-for-production"

# Groq Free API Configuration (Get your free key at https://console.groq.com/keys)
GROQ_API_KEY="your-groq-api-key-here"

# Configurable Groq model:
# - llama-3.3-70b-versatile (Recommended for complex reasoning, tool calling & structured extraction)
# - llama-3.1-8b-instant (Fastest inference)
GROQ_MODEL="llama-3.3-70b-versatile"